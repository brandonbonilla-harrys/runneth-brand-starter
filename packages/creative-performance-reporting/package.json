      "target": { "root": "agent_brain", "path": "creative-performance-reporting/daily-performance-report.md" }
    },
    {
      "id": "monthly-digest-sop",
      "type": "file",
      "executable": false,
      "sourcePath": "monthly-strategy-digest.md",
      "target": { "root": "agent_brain", "path": "creative-performance-reporting/monthly-strategy-digest.md" }
    },
    {
      "id": "activation",
      "type": "package_instruction",
      "executable": false,
      "sourcePath": "instructions/activation.md",
      "target": { "root": "package_instructions", "path": "creative-performance-reporting/activation.md" }
    }

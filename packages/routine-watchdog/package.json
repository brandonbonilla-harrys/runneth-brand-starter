{
  "schemaVersion": 1,
  "id": "routine-watchdog",
  "name": "Routine Watchdog",
  "version": "1",
  "description": "Keeps the brand's routines healthy: a periodic check of routine run history that flags failures, silent no-ops, and stalls, and reports them to an owner. Read-only over the routine system; never edits routines it doesn't own. Self-onboarding; install stages files only.",
  "categories": ["brand-starter-26"],
  "installPolicy": "auto",
  "updatePolicy": "auto",
  "uninstallPolicy": "allowed",
  "resources": [
    { "id": "readme", "type": "file", "executable": false, "sourcePath": "README.md", "target": { "root": "agent_brain", "path": "routine-watchdog/README.md" } },
    { "id": "runbook", "type": "file", "executable": false, "sourcePath": "runbook.md", "target": { "root": "agent_brain", "path": "routine-watchdog/runbook.md" } },
    { "id": "activation", "type": "package_instruction", "executable": false, "sourcePath": "instructions/activation.md", "target": { "root": "package_instructions", "path": "routine-watchdog/activation.md" } }
  ]
}
